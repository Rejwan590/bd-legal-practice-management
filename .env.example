# BD Legal Practice Management - Environment Configuration
# Placeholder configuration values for local development only. Do NOT put production secrets here.

# Frontend Configuration
VITE_DATA_SOURCE=mock # 'mock' or 'rest'
VITE_API_BASE_URL=http://localhost:4000/api/v1
# Demo Quick Access (Dev mode only - disabled in production)
VITE_ENABLE_DEMO_LOGIN=false
VITE_DEMO_OWNER_EMAIL=owner@firm.bd
VITE_DEMO_OWNER_PASSWORD=OwnerPassword123!
VITE_DEMO_STAFF_EMAIL=staff@firm.bd
VITE_DEMO_STAFF_PASSWORD=StaffPassword123!

# Backend Configuration (for /server)
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://bd_legal_user:bd_legal_secret_password@localhost:5432/bd_legal_db
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
ADMIN_JWT_SECRET=your_super_secret_admin_jwt_key_at_least_32_chars
CORS_ORIGIN=http://localhost:3000

# Docker PostgreSQL Configuration
POSTGRES_DB=bd_legal_db
POSTGRES_USER=bd_legal_user
POSTGRES_PASSWORD=bd_legal_secret_password

# Database Seeding Passwords (Development only; if unset, random passwords are automatically generated)
SEED_OWNER_PASSWORD=OwnerPassword123!
SEED_STAFF_PASSWORD=StaffPassword123!
