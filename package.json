{
  "name": "bd-legal-practice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "node server/dist/index.js",
    "build": "vite build",
    "build:admin": "npm run build --prefix admin-app",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit --project admin-app/tsconfig.json",
    "test:health": "tsx scripts/runHealth.ts",
    "test:restFetch": "tsx tests/restFetch.test.ts",
    "test:hardening": "tsx tests/authAndContractHardening.test.ts",
    "test:dashboard": "tsx tests/dashboard.test.ts",
    "test:responsive": "playwright test",
    "seed:synthetic": "tsx scripts/populateSyntheticData.ts",
    "seed:synthetic:clean": "tsx scripts/populateSyntheticData.ts --clean",
    "postinstall": "node --input-type=module -e \"import {execSync} from 'node:child_process';if(process.env.VERCEL||process.env.VERCEL_ENV||process.env.NOW_BUILDER){try{execSync('npm install --prefix server',{stdio:'inherit'});}catch(e){console.warn(e.message);}}\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.15",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
