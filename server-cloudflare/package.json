{
  "name": "bd-legal-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setupCloudflare.mjs",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bdlegal-d1-prod --local",
    "db:migrate:prod": "wrangler d1 migrations apply bdlegal-d1-prod --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.7.7",
    "@cloudflare/workers-types": "^4.20250224.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "wrangler": "^3.114.0"
  }
}
