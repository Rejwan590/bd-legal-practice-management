{
  "name": "bd-legal-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx tests/foundation.test.ts && tsx tests/clients.test.ts && tsx tests/cases.test.ts && tsx tests/hearings.test.ts && tsx tests/tasks.test.ts && tsx tests/accounts.test.ts && tsx tests/postgres.test.ts && tsx tests/adminAuth.test.ts && tsx tests/adminFirms.test.ts && tsx tests/devices.test.ts && tsx tests/teamVisibility.test.ts",
    "test:foundation": "tsx tests/foundation.test.ts",
    "test:clients": "tsx tests/clients.test.ts",
    "test:cases": "tsx tests/cases.test.ts",
    "test:hearings": "tsx tests/hearings.test.ts",
    "test:tasks": "tsx tests/tasks.test.ts",
    "test:accounts": "tsx tests/accounts.test.ts",
    "test:postgres": "tsx tests/postgres.test.ts",
    "test:admin": "tsx tests/adminAuth.test.ts",
    "test:admin-firms": "tsx tests/adminFirms.test.ts",
    "test:devices": "tsx tests/devices.test.ts",
    "test:visibility": "tsx tests/teamVisibility.test.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "admin:license": "tsx src/scripts/adminLicense.ts",
    "admin:create": "tsx scripts/createPlatformAdmin.ts",
    "postinstall": "node --input-type=module -e \"if(process.env.VERCEL||process.env.VERCEL_ENV||process.env.NOW_BUILDER){const esbuild=await import('esbuild');await esbuild.build({entryPoints:['src/app.ts'],bundle:true,platform:'node',target:'node20',format:'cjs',outfile:'src/app.bundle.cjs'});}\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
