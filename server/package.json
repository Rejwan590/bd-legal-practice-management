{
  "name": "bd-legal-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs --footer:js=\"module.exports = app; module.exports.default = app;\" && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "test": "tsx tests/foundation.test.ts && tsx tests/clients.test.ts && tsx tests/cases.test.ts && tsx tests/hearings.test.ts && tsx tests/tasks.test.ts && tsx tests/physicalFiles.test.ts && tsx tests/accounts.test.ts && tsx tests/postgres.test.ts && tsx tests/adminAuth.test.ts && tsx tests/adminFirms.test.ts && tsx tests/devices.test.ts && tsx tests/teamVisibility.test.ts && tsx tests/appointments.test.ts && tsx tests/auditTrailComprehensive.test.ts && tsx tests/corsAuthConnectivity.test.ts && tsx tests/chamberExpenses.test.ts && tsx tests/seatAndDevicePricing.test.ts && tsx tests/plansPricingStage1.test.ts && tsx tests/customTrialStage2.test.ts",
    "test:physical-files": "tsx tests/physicalFiles.test.ts",
    "test:plans-pricing": "tsx tests/plansPricingStage1.test.ts",
    "test:custom-trial": "tsx tests/customTrialStage2.test.ts",
    "test:chamber": "tsx tests/chamberExpenses.test.ts",
    "test:cors": "tsx tests/corsAuthConnectivity.test.ts",
    "test:audit": "tsx tests/auditTrailComprehensive.test.ts",
    "test:foundation": "tsx tests/foundation.test.ts",
    "test:clients": "tsx tests/clients.test.ts",
    "test:cases": "tsx tests/cases.test.ts",
    "test:hearings": "tsx tests/hearings.test.ts",
    "test:tasks": "tsx tests/tasks.test.ts",
    "test:accounts": "tsx tests/accounts.test.ts",
    "test:postgres": "tsx tests/postgres.test.ts",
    "test:admin": "tsx tests/adminAuth.test.ts",
    "test:admin-firms": "tsx tests/adminFirms.test.ts",
    "test:devices": "tsx tests/devices.test.ts",
    "test:visibility": "tsx tests/teamVisibility.test.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "seed:synthetic": "tsx ../scripts/populateSyntheticData.ts",
    "seed:synthetic:clean": "tsx ../scripts/populateSyntheticData.ts --clean",
    "admin:license": "tsx src/scripts/adminLicense.ts",
    "admin:create": "tsx src/scripts/createPlatformAdmin.ts",
    "admin:create:prod": "node dist/scripts/createPlatformAdmin.js",
    "admin:reset": "tsx src/scripts/resetPlatformAdminPassword.ts",
    "test:appointments": "tsx tests/appointments.test.ts",
    "test:pricing": "tsx tests/seatAndDevicePricing.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "esbuild": "^0.25.0"
  }
}
